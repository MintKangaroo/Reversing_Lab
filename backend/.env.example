# Copy to .env and adjust as needed. All settings are also overridable via the
# environment (same names, e.g. `export RLAB_LOG_LEVEL=DEBUG`).

# --- Storage ---
RLAB_DATABASE_URL=sqlite:///./reversing_lab.db
# PostgreSQL requires requirements-postgres.txt:
# RLAB_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1/reversing_lab
RLAB_STORAGE_DIR=./data/binaries

# --- Upload / analysis limits ---
RLAB_MAX_UPLOAD_BYTES=33554432
RLAB_MAX_MEMORY_DUMP_BYTES=536870912
RLAB_MAX_DISASSEMBLY_INSTRUCTIONS=20000
RLAB_MAX_CFG_INSTRUCTIONS=8000
RLAB_MAX_FUNCTION_SCAN_INSTRUCTIONS=50000
RLAB_MAX_INSTRUCTIONS_PER_FUNCTION=4000
RLAB_MAX_FUNCTIONS=5000
RLAB_MAX_CFG_NODES=2000
RLAB_MAX_CALL_GRAPH_NODES=2000
RLAB_MAX_STRINGS=10000
RLAB_MAX_YARA_MATCHES=1000
RLAB_MAX_DYNAMIC_EVENTS=100000
RLAB_MAX_MEMORY_PROCESSES=10000
RLAB_MAX_MEMORY_MODULES=50000
RLAB_MAX_MEMORY_REGIONS=100000
RLAB_MAX_MEMORY_NETWORK_RECORDS=50000
RLAB_MAX_MEMORY_FINDINGS=1000
RLAB_MAX_AUDIT_EXPORT_RECORDS=100000
RLAB_MAX_ANALYSIS_SECONDS=300
RLAB_MAX_DECOMPILER_SECONDS=45
RLAB_MAX_EXTERNAL_OUTPUT_BYTES=2097152
RLAB_MAX_CONCURRENT_JOBS=2
RLAB_HEX_PAGE_SIZE=1024

# --- HTTP ---
RLAB_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RLAB_LOG_LEVEL=INFO

# --- Authentication: disabled for backward-compatible local development ---
RLAB_AUTH_MODE=disabled
# Map lowercase SHA-256 key digests to "principal:role". Roles are viewer,
# analyst, and admin. Never put raw API keys in this file.
# RLAB_AUTH_API_KEY_HASHES={"<64-character-sha256>":"analyst-one:analyst"}

# --- Integrations ---
RLAB_RADARE2_PATH=r2
RLAB_UPX_PATH=upx
RLAB_VOLATILITY_PATH=vol
RLAB_INTEGRATION_TIMEOUT_SECONDS=30
# GHIDRA_HOME=/opt/ghidra          # enable the Ghidra integration

# --- Dynamic analysis: disabled unless every guardrail is configured ---
RLAB_SANDBOX_PROVIDER=disabled
RLAB_SANDBOX_NETWORK_POLICY=blocked
RLAB_SANDBOX_TIMEOUT_SECONDS=60
RLAB_SANDBOX_MEMORY_MB=512
RLAB_SANDBOX_CPU_COUNT=1
RLAB_SANDBOX_PROCESS_LIMIT=32
# RLAB_SANDBOX_WORKER_URL=https://isolated-worker.internal
# RLAB_SANDBOX_WORKSPACE_DIR=/private/sandbox-work
